# Контекст сборки — корень репозитория.
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build
COPY ["3 lab/pom.xml", "./pom.xml"]
COPY ["3 lab/src", "./src"]
RUN mvn -B -DskipTests package

FROM eclipse-temurin:17-jre-jammy
# curl используется для HTTP healthcheck существующего endpoint OpenAPI.
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /build/target/student-management-0.0.1-SNAPSHOT.jar app.jar
# /app/data хранит автоматически созданные ключи JWT; volume в Compose сохраняет их при рестарте.
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
