# Сервер Nuxt → Java. В Docker Desktop: http://host.docker.internal:8080/api
# В общей docker-сети: http://backend:8080/api (если сервис действительно называется backend).
NUXT_JAVA_API_BASE=http://localhost:8080/api
# Браузер → Nuxt того же origin. Это адрес будущего транспорта, НЕ адрес Java.
NUXT_PUBLIC_API_BASE=/api/backend
# Только просмотр учебных заглушек: middleware пропускает страницы, API остаётся 501.
# После реализации авторизации обязательно false.
NUXT_PUBLIC_LAB_PREVIEW=true
# Для локального HTTP false; для production HTTPS true. Пока cookies не реализованы.
NUXT_COOKIE_SECURE=false
